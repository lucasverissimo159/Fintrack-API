# Server
PORT=3000
NODE_ENV=development

# Database (SQLite file path)
DB_PATH=./data/finance.db

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Set only when deployed behind a reverse proxy or PaaS (Render, Railway, Heroku,
# nginx...) so express-rate-limit and req.ip see the real client IP instead of
# the proxy's. Common value: 1 (trust one hop). Leave unset for local/bare-metal runs.
TRUST_PROXY=
