{
  "name": "fintrack-api",
  "version": "1.0.0",
  "description": "REST API for personal finance management with JWT auth, budgets, recurring transactions and analytics endpoints designed for Power BI and Power Apps / Power Automate integration.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest-api",
    "sqlite",
    "jwt",
    "finance",
    "power-bi",
    "power-apps",
    "power-automate",
    "openapi",
    "swagger"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
